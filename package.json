{
  "name": "thousandeyes-synthetics-ci-github-action",
  "version": "0.1.0",
  "private": true,
  "description": "Thin GitHub Action for ThousandEyes synthetic CI tests",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/tool-cache": "4.0.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0"
  }
}
